# NxtWave Referral-Powered Registration Engine Environment Variables
# Copy this file to .env.local to customize keys.
# The app works out-of-the-box with localStorage fallback even if these are unset.

# Optional: Google Gemini API Key for live AI Project Idea generation
# If left empty, the app seamlessly falls back to 30+ curated branch-specific project blueprints.
VITE_GEMINI_API_KEY=

# Optional: Supabase configuration for cloud database persistence
# If left empty, the app persists registrations and referral counts to localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Sheets Apps Script Webhook URL for backup Google Sheet CRM sync
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# Admin Dashboard Password (Default is nxtwave2026)
VITE_ADMIN_PASSWORD=nxtwave2026
